      "builtIn": true,
      "formSchema": {
        "blocks": [
          {
            "id": "params",
            "kind": "formInfo",
            "column": 1,
            "list": [
              {
                "id": "params-templateId",
                "type": "MailTemplateSelect",
                "name": "templateId",
                "label": "邮件模版",
                "description": "选择模版后使用模版的主题与正文，模版主题为空时使用下方回复主题"
              },
              {
                "id": "params-subject",
                "type": "MailTemplateText",
                "name": "subject",
                "label": "回复主题",
                "props": {
                  "defaultValue": "Re: {{mail.subject}}"
                }
              },
              {
                "id": "params-html",
                "type": "MailEditor",
                "name": "html",
                "label": "回复内容",
                "description": "未选择模版时必填"
              },
              {
                "id": "params-intervalHours",
                "type": "InputNumber",
                "name": "intervalHours",
                "label": "同一发件人最短回复间隔（小时）",
                "props": {
                  "defaultValue": 24,
                  "min": 0
                }
              }
            ]
          }
        ]
      }
    },
