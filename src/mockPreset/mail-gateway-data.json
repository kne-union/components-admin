  "rules": [
    {
      "id": "rule-1",
      "name": "发票归档并通知财务系统",
      "description": "主题含“发票”或来自账单域名的邮件打上发票标签，并推送到财务系统",
      "direction": "receive",
      "accountIds": [],
      "conditions": {
        "match": "any",
        "items": [
          {
            "field": "subject",
            "operator": "contains",
            "value": "发票"
          },
          {
            "field": "from",
            "operator": "endsWith",
            "value": "@invoice.example.com"
          }
        ]
      },
      "actions": [
        {
          "type": "addLabel",
          "params": {
            "labelIds": ["lb-1"]
          }
        },
        {
          "type": "webhook",
          "params": {
            "url": "https://finance.leapin-ai.com/hooks/mail",
            "secret": "fin-2026",
            "timeout": 10000
          }
        }
      ],
      "priority": 0,
      "stopProcessing": true,
      "status": "enabled",
      "createdAt": "2026-09-05T10:00:00+08:00"
    },
    {
      "id": "rule-2",
      "name": "客服邮箱自动回复",
      "description": "客户来信自动回复受理通知，并标记为客户咨询",
      "direction": "receive",
      "accountIds": ["acc-1"],
      "conditions": {
        "match": "all",
        "items": [
          {
            "field": "from",
            "operator": "notContains",
            "value": "@leapin-ai.com"
          }
        ]
      },
      "actions": [
        {
          "type": "autoReply",
          "params": {
            "templateId": "tpl-1",
            "subject": "Re: {{mail.subject}}",
            "intervalHours": 24
          }
        },
        {
          "type": "addLabel",
          "params": {
            "labelIds": ["lb-2"]
          }
        }
      ],
      "priority": 1,
      "stopProcessing": false,
      "status": "enabled",
      "createdAt": "2026-09-06T10:00:00+08:00"
    },
    {
      "id": "rule-3",
      "name": "紧急邮件转发值班主管",
      "description": "主题含“紧急”的邮件加星标并转发给值班主管",
      "direction": "receive",
      "accountIds": [],
      "conditions": {
        "match": "all",
        "items": [
          {
            "field": "subject",
            "operator": "regex",
            "value": "紧急|urgent"
          }
        ]
      },
      "actions": [
        {
          "type": "addLabel",
          "params": {
            "labelIds": ["lb-3"]
          }
        },
        {
          "type": "star",
          "params": {}
        },
        {
          "type": "forward",
          "params": {
            "to": ["duty-manager@leapin-ai.com"],
            "comment": "请优先处理"
          }
        }
      ],
      "priority": 2,
      "stopProcessing": false,
      "status": "enabled",
      "createdAt": "2026-09-08T10:00:00+08:00"
    },
    {
      "id": "rule-4",
      "name": "外发邮件同步 CRM",
      "description": "客服发出的邮件同步到 CRM 客户跟进记录",
      "direction": "send",
      "accountIds": ["acc-1"],
      "conditions": {
        "match": "all",
        "items": []
      },
      "actions": [
        {
          "type": "webhook",
          "params": {
            "url": "https://crm.leapin-ai.com/hooks/mail-sent",
            "timeout": 5000
          }
        }
      ],
      "priority": 3,
      "stopProcessing": false,
      "status": "disabled",
      "createdAt": "2026-09-12T10:00:00+08:00"
    }
  ],
